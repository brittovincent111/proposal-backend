# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=6000
API_PREFIX=api/v1
# Express request-body cap for JSON and form payloads, e.g. embedded document HTML.
REQUEST_BODY_LIMIT=10mb

# --- database ----------------------------------------------------------------
# A single mongod works for development. Multi-document transactions require a
# replica set; the code does not depend on them, but production should use one.
MONGODB_URI=mongodb://127.0.0.1:27021/qtn

# --- authentication ----------------------------------------------------------
# Generate with: openssl rand -base64 48
# Both must be at least 32 characters. Never reuse them across environments.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Google OAuth (optional) -------------------------------------------------
# Get from https://console.cloud.google.com/
# Add authorized origins: http://localhost:7001, http://localhost:6000, your-production-domain.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- urls --------------------------------------------------------------------
APP_URL=http://localhost:7001
API_URL=http://localhost:6000
PUBLIC_PROPOSAL_BASE_URL=http://localhost:7001/p
# Comma-separated. Credentials are cookies, so this list is a security boundary.
CORS_ORIGINS=http://localhost:7001

# --- cookies -----------------------------------------------------------------
# COOKIE_DOMAIN is only needed when the API and app are on different subdomains.
# COOKIE_DOMAIN=.example.com
# Defaults to true in production. Set explicitly when testing HTTPS locally.
# COOKIE_SECURE=false

# --- rate limiting -----------------------------------------------------------
PUBLIC_RATE_LIMIT=30
PUBLIC_RATE_TTL_SECONDS=60

# --- storage (not used by this build; assets module is not implemented yet) ---
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=

# --- billing (Razorpay) ------------------------------------------------------
# Leave the key pair unset to run without payments: plans and subscriptions
# still work, checkout answers BILLING_NOT_CONFIGURED instead of failing oddly.
# Test keys start with rzp_test_. Never commit live keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard → Settings → Webhooks, alongside the endpoint
# <API_URL>/api/v1/billing/webhooks/razorpay. Signs every delivery.
# RAZORPAY_WEBHOOK_SECRET=
# Trial length used when the chosen plan does not define its own.
BILLING_TRIAL_DAYS=14
# Days a PAST_DUE tenant keeps full access before dropping to read-only.
BILLING_GRACE_DAYS=7

# --- blog drafting (OpenAI) --------------------------------------------------
# Draft generation stays human-reviewed: the app saves AI output as DRAFT only.
# Add a fresh key locally. Do not commit a real key.
# OPENAI_API_KEY=sk-...
# Optional override. Keep this aligned with the model enabled on your account.
# OPENAI_BLOG_MODEL=gpt-4.1-mini
# Optional override for the topic-selection agent.
# OPENAI_BLOG_TOPIC_MODEL=gpt-4.1-mini
